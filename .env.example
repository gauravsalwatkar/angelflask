# Copy this file to .env and fill in real values.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/Angelone

# --- Angel One SmartAPI ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Optional override
# ANGEL_SCRIP_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json

# --- App ---
DATA_DIR=data
HISTORIC_FETCH_MAX_THREADS=2

# --- Position sizing (rupees) ---
# Each BUY is sized so the loss at the stop loss stays within MAX_LOSS_PER_TRADE
TRADING_CAPITAL=100000
MAX_LOSS_PER_TRADE=1000
# Virtual money in each paper-trading book
PAPER_CAPITAL=100000

# --- News analysis (Claude API) ---
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 is more thorough but costs more per scan
# ANTHROPIC_MODEL=claude-sonnet-5-5
# NEWS_CACHE_SECONDS=3600
